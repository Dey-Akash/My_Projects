<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Amount</name>
        <label>Set Amount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Check_payment.Final_Paid_Amount__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>updateamount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_payment</targetReference>
        </connector>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>updateamount</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!Check_payment.Booking__r.Paying_Fare_With_Gst__c}, 0)
+
BLANKVALUE({!$Record.Extra_Charge__c}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Update Payment from Baggage {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Payment from Baggage Airline Management</label>
    <loops>
        <name>Check_payment</name>
        <label>Check payment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Payments</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Set_Amount</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>final_amount_update</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Payments</name>
        <label>Get Payments</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_payment</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Baggage__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Payment__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>final_amount_update</name>
        <label>final amount update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>Get_Payments</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Payments</targetReference>
        </connector>
        <filterFormula>ISCHANGED({!$Record.Extra_Charge__c})</filterFormula>
        <object>Baggage__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
