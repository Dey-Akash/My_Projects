<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Journey_Date_Validation</fullName>
    <active>true</active>
    <description>journey date cannot be past date</description>
    <errorConditionFormula>Journey_Date__c &lt; TODAY()</errorConditionFormula>
    <errorDisplayField>Journey_Date__c</errorDisplayField>
    <errorMessage>Journey Date cannot be in the past.</errorMessage>
</ValidationRule>
