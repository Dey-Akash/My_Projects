<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_the_stal_reason_value</name>
        <label>Assign the stal reason value</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outputConfirmation</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>&apos;Stall reason recorded on Opportunity.&apos;</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <description>Updates the Stall Reason field on the specified Opportunity.</description>
    <environments>Default</environments>
    <interviewLabel>Set Opportunity Stall Reason {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Set Opportunity Stall Reason</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Stall_Reason</name>
        <label>Update Stall Reason</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Assign_the_stal_reason_value</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputOpportunityId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Stall_Reason__c</field>
            <value>
                <elementReference>inputStallReason</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Stall_Reason</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>The Id of the Opportunity to update.</description>
        <name>inputOpportunityId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>The reason the deal stalled or is being closed out. Max 255 chars.</description>
        <name>inputStallReason</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Confirmation the Stall Reason was recorded.</description>
        <name>outputConfirmation</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
